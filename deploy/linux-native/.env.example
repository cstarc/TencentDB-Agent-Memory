# 复制为 .env 并填写。真实 key 不要提交进 git。
# ── LLM：memory 组（memory-core 记忆抽取 + knowledge wiki ingest）──
MEMORY_LLM_BASE_URL=https://api.deepseek.com/v1
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=deepseek-chat
MEMORY_LLM_PROTOCOL=openai

# ── LLM：proxy 组（coding agent 请求的转发上游）──
PROXY_UPSTREAM_URL=https://api.deepseek.com/v1
PROXY_UPSTREAM_API_KEY=
PROXY_UPSTREAM_MODEL=deepseek-chat

# ── 端口（与官方 docker 部署一致）──
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ── 网络 ──
# 服务监听地址（容器内部保持 0.0.0.0 即可）
BIND_HOST=0.0.0.0
# 对外可达地址：留空 = 自动取容器 IP（同网段直连可用）。
# 端口经 NAT/宿主机映射暴露时必须显式指定，如 PUBLIC_HOST=10.1.2.3
PUBLIC_HOST=

# ── 记忆提示词模式：code（默认）| chat ──
MEMORY_PROMPT_MODE=code
